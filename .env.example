# 复制为 .env 后按需修改（也可直接在管理台 ③ 里改，会写入 config.json）

# 上游 WorkBuddy
WB_BASE=https://www.[WORK_BUDDY_HOST]
WB_CHAT_PATH=/api/chat
WB_QUOTA_PATH=/api/user/quota
WB_MODELS_PATH=/api/models
WB_ORIGIN=https://www.[WORK_BUDDY_HOST]
WB_REFERER=https://www.[WORK_BUDDY_HOST]/chat
WB_RESPONSE_MODE=sse
WB_DEFAULT_MODEL=workbuddy-default
WB_AUTO_NEW_CONV=0
# 附加请求头（JSON）
WB_EXTRA_HEADERS={"x-workspace-id":""}

# 本地服务
PORT=8787
HOST=127.0.0.1
# 对外 API 密钥；留空表示不鉴权
API_KEY=sk-workbuddy-local
# 管理台口令
ADMIN_PASSWORD=workbuddy
MAX_CONCURRENCY=8
TIMEOUT_MS=300000
CORS_ORIGIN=*

# 工具调用解析模式：auto | fence | json
TOOL_MODE=auto
# 别名映射（JSON）
WB_MODEL_ALIAS={"gpt-4o":"workbuddy-pro"}

# 抓包代理端口
WB_SNIFF_PORT=8899
# 不解密直连的域名（逗号分隔），如启用了证书固定的站点
WB_SNIFF_PASSTHROUGH=

# 自动重登（需安装 playwright）
AUTO_RELOGIN=false
WB_HEADLESS=false
